<Window x:Class="WorldDownloaderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="World Downloader Manager" Height="940" Width="960" MinHeight="640" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="#0F1419">

    <Window.Resources>
        <!-- po:Freeze="False" keeps these mutable so the theme switcher can recolour them at runtime -->
        <SolidColorBrush x:Key="Bg" po:Freeze="False" Color="#0F1419" />
        <SolidColorBrush x:Key="Surface" po:Freeze="False" Color="#1A2029" />
        <SolidColorBrush x:Key="Surface2" po:Freeze="False" Color="#222A35" />
        <SolidColorBrush x:Key="Outline" po:Freeze="False" Color="#313B49" />
        <SolidColorBrush x:Key="Text" po:Freeze="False" Color="#E9EEF5" />
        <SolidColorBrush x:Key="Muted" po:Freeze="False" Color="#93A1B5" />
        <SolidColorBrush x:Key="Accent" po:Freeze="False" Color="#3DDC84" />
        <SolidColorBrush x:Key="Danger" po:Freeze="False" Color="#FF5C57" />
        <sys:Double x:Key="BodyFontSize">13</sys:Double>
        <sys:Double x:Key="HeadingFontSize">14</sys:Double>
        <sys:Double x:Key="LabelFontSize">12</sys:Double>
        <sys:Double x:Key="DescriptionFontSize">11.5</sys:Double>
        <sys:Double x:Key="TitleFontSize">22</sys:Double>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style x:Key="Desc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="{DynamicResource DescriptionFontSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,4,0,0" />
        </Style>

        <Style x:Key="Tb" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pb" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="b" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#052213" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="#2A0605" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="8">
                                            <Path Data="M 0 0 L 5 5 L 10 0 Z" Fill="{StaticResource Muted}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Outline}"
                                        BorderThickness="1.5" CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0">
                                    <ScrollViewer Margin="4" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2}" />
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2}" />
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Bg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Surface2}" />
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Outline}" BorderThickness="1"
                                CornerRadius="12,12,4,4" Padding="16,10">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="TabChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- pill toggle built from a CheckBox -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="44" Height="24" CornerRadius="12"
                                Background="{StaticResource Surface2}" BorderBrush="{StaticResource Outline}" BorderThickness="2">
                            <Ellipse x:Name="thumb" Width="14" Height="14" HorizontalAlignment="Left"
                                     Margin="3,0,0,0" Fill="{StaticResource Muted}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#2A3D32" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="thumb" Property="Fill" Value="{StaticResource Accent}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="track" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
      <TabControl x:Name="MainTabs" Margin="16" Background="{StaticResource Bg}" BorderThickness="0"
                  AutomationProperties.Name="World Downloader pages">
       <TabItem Header="Downloader" AutomationProperties.Name="Downloader tab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Margin="26" MaxWidth="780" HorizontalAlignment="Stretch">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="&#x26CF;" FontSize="32" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="World Downloader" Foreground="{StaticResource Text}" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold" />
                        <TextBlock Text="Set up and run the web console in Docker" Foreground="{StaticResource Muted}" FontSize="13" />
                    </StackPanel>
                </StackPanel>
                <!-- Accessibility / theme controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Theme" Style="{StaticResource Lbl}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ThemeBox" Width="124" SelectionChanged="Theme_Changed"
                              AutomationProperties.Name="Colour theme"
                              ToolTip="Switch between dark, light and high-contrast themes">
                        <ComboBoxItem Content="Dark" IsSelected="True" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="High contrast" />
                    </ComboBox>
                    <CheckBox x:Name="LargeTextBox" Content="Large text" Margin="14,0,0,0" VerticalAlignment="Center"
                              Foreground="{StaticResource Text}" Click="LargeText_Changed"
                              AutomationProperties.Name="Large text"
                              ToolTip="Increase the size of everything for easier reading" />
                </StackPanel>
            </DockPanel>

            <!-- Status -->
            <Border x:Name="StatusBorder" CornerRadius="10" Padding="14,11" Margin="0,0,0,16"
                    Background="#1B2733" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap"
                           Text="Checking Docker…" />
            </Border>

            <!-- Data folder -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="Data folder" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Style="{StaticResource Tb}" IsReadOnly="True"
                                 ToolTip="The folder on your PC where everything is kept. It is mapped into the container as /data." />
                        <Button x:Name="BrowseBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…"
                                Margin="8,0,0,0" Click="Browse_Click"
                                ToolTip="Pick the folder where downloaded worlds and data should be saved." />
                    </Grid>
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Where downloaded worlds, the block/registry cache, your Minecraft account session and the console's saved settings are stored. Pick a folder with plenty of free space — a large world can be several GB." />
                </StackPanel>
            </Border>

            <!-- Configuration -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="Configuration" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Web console port" />
                            <TextBox x:Name="WebPortBox" Style="{StaticResource Tb}" Text="8080"
                                     ToolTip="The port the management website listens on." />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="The console is served here — open http://localhost:&lt;this port&gt; in your browser." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Minecraft proxy port" />
                            <TextBox x:Name="ProxyPortBox" Style="{StaticResource Tb}" Text="25565"
                                     ToolTip="The port the downloader's proxy listens on." />
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="In Minecraft, connect to localhost:&lt;this port&gt; instead of the real server to download." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Lbl}" Text="Minecraft server address" />
                        <TextBox x:Name="ServerBox" Style="{StaticResource Tb}"
                                 AutomationProperties.Name="Minecraft server address to download from"
                                 ToolTip="The remote server to download from (hostname or IP, without a port)." />
                        <TextBlock Style="{StaticResource Desc}"
                                   Text="Baked into the generated docker-compose.yml so the container is preconfigured. You can still change it later in the web console." />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="World output directory" />
                            <TextBox x:Name="OutputDirBox" Style="{StaticResource Tb}" Text="world"
                                     AutomationProperties.Name="World output directory under the data folder"
                                     ToolTip="Folder under the data volume where the world is written." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox x:Name="AutoStartCheck" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                          AutomationProperties.Name="Start downloading automatically on boot"
                                          ToolTip="Start downloading automatically when the container boots." />
                                <TextBlock Text="Start download on boot" Foreground="{StaticResource Text}"
                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Desc}"
                                       Text="Needs an account already signed in (it persists in the data folder)." />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Lbl}" Text="Docker image" />
                        <TextBox x:Name="ImageBox" Style="{StaticResource Tb}"
                                 ToolTip="The container image to run." />
                        <TextBlock Style="{StaticResource Desc}"
                                   Text="The Docker image that gets run. Leave the default unless you build/host your own; use “Update image” to fetch the newest version." />
                    </StackPanel>

                    <!-- Build locally from source instead of pulling -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="BuildLocalCheck" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                  Checked="BuildLocal_Changed" Unchecked="BuildLocal_Changed"
                                  AutomationProperties.Name="Build the image locally from source"
                                  ToolTip="Build the Docker image from source on this PC instead of pulling the prebuilt one." />
                        <TextBlock Text="Build image locally from source" Foreground="{StaticResource Text}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Builds the image from a local source checkout (which must contain the Dockerfile) instead of downloading it — useful offline, behind a firewall, or to run your own changes. The first build can take a few minutes." />
                    <StackPanel x:Name="BuildPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Lbl}" Text="Source folder (contains the Dockerfile)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BuildContextBox" Style="{StaticResource Tb}"
                                     ToolTip="Folder of the minecraft-world-downloader source (with the Dockerfile)." />
                            <Button x:Name="BuildBrowseBtn" Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…"
                                    Margin="8,0,0,0" Click="BrowseBuildContext_Click"
                                    AutomationProperties.Name="Browse for the source folder" />
                        </Grid>
                        <TextBlock Style="{StaticResource Desc}"
                                   Text="Leave blank to auto-detect when this app is run from inside the repo. Otherwise pick the folder containing the Dockerfile." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="LoginCheck" Style="{StaticResource Toggle}" VerticalAlignment="Center"
                                  Checked="Login_Changed" Unchecked="Login_Changed"
                                  ToolTip="Protect the console with a username and password." />
                        <TextBlock Text="Require a login to open the console" Foreground="{StaticResource Text}"
                                   FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Off by default (fine for your own PC). Turn on to require the username and password below — recommended if the console is reachable from your network." />

                    <CheckBox x:Name="ExposeWebCheck" Content="Allow other devices on this network to open the web console"
                              Foreground="{StaticResource Text}" MinHeight="44" Margin="0,12,0,0"
                              AutomationProperties.Name="Expose web console to the local network"
                              ToolTip="Off keeps the web console bound to 127.0.0.1 on this PC. Turn on only when network access is intentional." />
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Off by default: the console stays on this PC. Turning this on binds it to every network interface; enable console login first." />

                    <Grid x:Name="LoginPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Console username" />
                            <TextBox x:Name="UserBox" Style="{StaticResource Tb}" ToolTip="Username asked for when opening the console." />
                            <TextBlock Style="{StaticResource Desc}" Text="The username you’ll type to open the console." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Console password" />
                            <PasswordBox x:Name="PassBox" Style="{StaticResource Pb}" PasswordChanged="SecretPassword_Changed" ToolTip="Password asked for when opening the console." />
                            <TextBlock Style="{StaticResource Desc}" Text="The password you’ll type to open the console." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartBtn" Style="{StaticResource AccentBtn}" Content="Start" Click="Start_Click"
                                ToolTip="Create and start the container with the settings above, then open the console in your browser." />
                        <Button x:Name="StopBtn" Style="{StaticResource DangerBtn}" Content="Stop" Margin="10,0,0,0" IsEnabled="False" Click="Stop_Click"
                                ToolTip="Stop and remove the running container. Your saved worlds in the data folder are kept." />
                        <Button x:Name="OpenBtn" Style="{StaticResource Btn}" Content="Open console" Margin="10,0,0,0" Click="Open_Click"
                                ToolTip="Open the console website (http://localhost:&lt;web port&gt;) in your default browser." />
                        <Button x:Name="LiveMapBtn" Style="{StaticResource Btn}" Content="Live map" Margin="10,0,0,0" Click="OpenLiveMap_Click"
                                AutomationProperties.Name="Open the live overview map"
                                ToolTip="Open the live overview map (http://localhost:&lt;web port&gt;/map) in your browser." />
                        <Button x:Name="PullBtn" Style="{StaticResource Btn}" Content="Update image" Margin="10,0,0,0" Click="Pull_Click"
                                ToolTip="Download the latest version of the Docker image from the registry." />
                        <Button x:Name="ComposeBtn" Style="{StaticResource Btn}" Content="Generate compose" Margin="10,0,0,0" Click="GenerateCompose_Click"
                                ToolTip="Write a docker-compose.yml for the current settings into the data folder." />
                    </StackPanel>
                    <ProgressBar x:Name="Busy" Height="3" Margin="0,12,0,0" IsIndeterminate="True"
                                 Visibility="Collapsed" Background="{StaticResource Outline}" Foreground="{StaticResource Accent}" BorderThickness="0" />
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Start: launches everything and opens the browser.   Stop: shuts the container down (worlds are kept).   Open console: reopens the website.   Update image: pulls the newest build." />
                </StackPanel>
            </Border>

            <!-- 3D map (BlueMap) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="3D map (BlueMap)" />
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Upgrade the downloaded world with a server jar, then render an interactive 3D web map with BlueMap. Requires Python and Java on this PC."
                               Margin="2,2,0,8" />
                    <TextBlock Style="{StaticResource Lbl}" Text="Server jar for world upgrade (optional)" />
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerJarBox" Style="{StaticResource Tb}"
                                 AutomationProperties.Name="Server jar path for world upgrade" />
                        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Browse" Margin="8,0,0,0"
                                Click="BrowseJar_Click" AutomationProperties.Name="Browse for server jar" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Lbl}" Text="Render threads (0 = auto)" />
                            <TextBox x:Name="BmThreads" Style="{StaticResource Tb}" Text="0"
                                     AutomationProperties.Name="BlueMap render threads" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Web map port" />
                            <TextBox x:Name="BmPort" Style="{StaticResource Tb}" Text="8100"
                                     AutomationProperties.Name="BlueMap web map port" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Lbl}" Text="Dimensions to render" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <CheckBox x:Name="BmOverworld" Content="Overworld" IsChecked="True"
                                  Foreground="{StaticResource Text}" Margin="0,0,12,0" AutomationProperties.Name="Render overworld" />
                        <CheckBox x:Name="BmNether" Content="Nether" IsChecked="True"
                                  Foreground="{StaticResource Text}" Margin="0,0,12,0" AutomationProperties.Name="Render nether" />
                        <CheckBox x:Name="BmEnd" Content="End" IsChecked="True"
                                  Foreground="{StaticResource Text}" AutomationProperties.Name="Render the end" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="RenderMapBtn" Style="{StaticResource AccentBtn}" Content="Render 3D map"
                                Click="RenderMap_Click" AutomationProperties.Name="Render the 3D map with BlueMap"
                                ToolTip="Upgrade (if a server jar is set) and render the downloaded world, then serve it." />
                        <Button x:Name="OpenMapBtn" Style="{StaticResource Btn}" Content="Open 3D map" Margin="10,0,0,0"
                                Click="OpenMap_Click" AutomationProperties.Name="Open the rendered 3D map in the browser" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bot (auto-explore) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="Bot (auto-explore)" />
                    <TextBlock Style="{StaticResource Desc}"
                               Text="Run mineflayer bot(s) that connect through the proxy and walk/fly a grid so the whole area downloads automatically. Requires Node.js on this PC."
                               Margin="2,2,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Lbl}" Text="Account" />
                            <ComboBox x:Name="BotAuthBox" AutomationProperties.Name="Bot account type">
                                <ComboBoxItem Content="Offline" IsSelected="True" />
                                <ComboBoxItem Content="Microsoft" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Username (or MS email)" />
                            <TextBox x:Name="BotUserBox" Style="{StaticResource Tb}" Text="Scraper"
                                     AutomationProperties.Name="Bot username" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Lbl}" Text="Radius (blocks)" />
                            <TextBox x:Name="BotRadiusBox" Style="{StaticResource Tb}" Text="256"
                                     AutomationProperties.Name="Scrape radius in blocks" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Bots" />
                            <TextBox x:Name="BotCountBox" Style="{StaticResource Tb}" Text="1"
                                     AutomationProperties.Name="Number of bots" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Login password (AuthMe)" />
                            <PasswordBox x:Name="BotLoginPwBox" Style="{StaticResource Pb}" PasswordChanged="SecretPassword_Changed"
                                         AutomationProperties.Name="Auto-login password" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="BotCenterOnSpawn" Content="Center on spawn" IsChecked="True"
                                  Foreground="{StaticResource Text}" Margin="0,0,12,0" AutomationProperties.Name="Center the area on spawn" />
                        <CheckBox x:Name="BotPreferFly" Content="Fly (creative)" IsChecked="False"
                                  Foreground="{StaticResource Text}" Margin="0,0,12,0" AutomationProperties.Name="Prefer flying in creative" />
                        <CheckBox x:Name="BotRevisit" Content="Revisit downloaded" IsChecked="False"
                                  Foreground="{StaticResource Text}" AutomationProperties.Name="Revisit already-downloaded chunks" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BotStartBtn" Style="{StaticResource AccentBtn}" Content="Start bot"
                                Click="BotStart_Click" AutomationProperties.Name="Start the auto-explore bot"
                                ToolTip="Connect the bot(s) to the proxy and start exploring (installs scraper deps on first run)." />
                        <Button x:Name="BotStopBtn" Style="{StaticResource DangerBtn}" Content="Stop bot" Margin="10,0,0,0"
                                IsEnabled="False" Click="BotStop_Click" AutomationProperties.Name="Stop the bot" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Output -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H}" Text="Output" />
                    <TextBlock Style="{StaticResource Desc}" Text="Live output from the Docker commands this app runs." Margin="2,2,0,8" />
                    <TextBox x:Name="LogText" Style="{StaticResource Tb}" Height="210" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Muted}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
       </TabItem>

       <TabItem Header="Settings" AutomationProperties.Name="Settings tab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="SettingsPanel" Margin="26" MaxWidth="780">
          <TextBlock Style="{StaticResource H}" FontSize="22" Text="Settings" />
          <TextBlock Style="{StaticResource Desc}" Margin="2,3,0,16"
                     Text="Language, humour, appearance and startup preferences are saved for this Windows account. Humour styles every message—including errors and warnings—but never changes facts. You can reset it at any time." />

          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Search settings" />
           <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SettingsSearchBox" Style="{StaticResource Tb}" TextChanged="SettingsSearch_Changed" AutomationProperties.Name="Search settings" ToolTip="Plain-text search is the default." />
            <CheckBox x:Name="SettingsRegexModeCheck" Grid.Column="1" Content="Regex" Foreground="{StaticResource Text}" MinHeight="44" Margin="8,0,0,0" Click="SettingsSearchMode_Changed" AutomationProperties.Name="Use regex settings search" />
            <Button Grid.Column="2" Style="{StaticResource Btn}" Content=".*" Margin="8,0,0,0" Click="SettingsRegex_Click" AutomationProperties.Name="Open regex builder for settings search" />
            <Popup x:Name="SettingsRegexPopup" PlacementTarget="{Binding ElementName=SettingsSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="SettingsRegexPopup_Closed">
             <Border Style="{StaticResource Card}" Width="620" Margin="0,8,0,0"><StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Settings regex builder (.NET)" />
              <TextBlock Style="{StaticResource Desc}" Text="Local evaluation; flags i, m, s, n; 150 ms timeout. Closing returns focus to this search field." />
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
               <TextBox x:Name="SettingsRegexPattern" Style="{StaticResource Tb}" TextChanged="SettingsRegexPattern_Changed" AutomationProperties.Name="Settings search regex pattern" />
               <TextBox x:Name="SettingsRegexFlags" Grid.Column="1" Style="{StaticResource Tb}" Margin="8,0,0,0" Text="i" TextChanged="SettingsRegexPattern_Changed" AutomationProperties.Name="Settings search regex flags" />
              </Grid>
              <TextBlock x:Name="SettingsRegexFeedback" Style="{StaticResource Desc}" AutomationProperties.LiveSetting="Polite" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
               <Button Style="{StaticResource Btn}" Content="Literal" Click="SettingsRegexLiteral_Click"/><Button Style="{StaticResource Btn}" Content="Group" Margin="8,0,0,0" Click="SettingsRegexGroup_Click"/><Button Style="{StaticResource Btn}" Content="Anchor" Margin="8,0,0,0" Click="SettingsRegexAnchor_Click"/><Button Style="{StaticResource AccentBtn}" Content="Apply" Margin="8,0,0,0" Click="SettingsRegexApply_Click"/>
              </StackPanel>
             </StackPanel></Border>
            </Popup>
           </Grid>
           <TextBlock x:Name="SettingsSearchFeedback" Style="{StaticResource Desc}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></Border>

          <Border x:Name="LanguageSettingsCard" Tag="language english cantonese bilingual humour funny warning error" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Language &amp; voice" />
           <TextBlock Style="{StaticResource Lbl}" Text="Language mode" Margin="2,10,0,4" />
           <ComboBox x:Name="LanguageModeBox" SelectionChanged="Preference_Changed" AutomationProperties.Name="Language mode"><ComboBoxItem Content="English"/><ComboBoxItem Content="Cantonese · 廣東話"/><ComboBoxItem Content="Bilingual · 雙語"/></ComboBox>
           <TextBlock Style="{StaticResource Lbl}" Text="English funny level (1 serious – 5 maximum)" Margin="2,14,0,4" />
           <Slider x:Name="EnglishFunnySlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Preference_Changed" AutomationProperties.Name="English funny level" />
           <TextBlock Style="{StaticResource Lbl}" Text="Cantonese funny level / 廣東話搞笑程度 (1–5)" Margin="2,14,0,4" />
           <Slider x:Name="CantoneseFunnySlider" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Preference_Changed" AutomationProperties.Name="Cantonese funny level" />
           <TextBlock x:Name="CopyPreviewText" Style="{StaticResource Desc}" Margin="2,12,0,0" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></Border>

          <Border x:Name="AppearanceSettingsCard" Tag="appearance theme dark light high contrast font size accent large text dim sum startup" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Appearance &amp; startup" />
           <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Lbl}" Text="UI font family"/><TextBox x:Name="UiFontBox" Style="{StaticResource Tb}" TextChanged="Preference_Changed" AutomationProperties.Name="UI font family"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Style="{StaticResource Lbl}" Text="Font scale (75–200%)"/><Slider x:Name="UiFontScaleSlider" Minimum="0.75" Maximum="2" TickFrequency="0.05" ValueChanged="Preference_Changed" AutomationProperties.Name="UI font scale"/></StackPanel>
           </Grid>
           <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox x:Name="DimSumCheck" Style="{StaticResource Toggle}" Click="Preference_Changed" AutomationProperties.Name="Enable one-percent dim sum surprise"/><TextBlock Text="Enable the 1% startup dim-sum surprise" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
           <Button Style="{StaticResource Btn}" Content="Reset appearance defaults" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ResetAppearance_Click" />
          </StackPanel></Border>

          <Border x:Name="EditorSettingsCard" Tag="external editor vscode visual studio code file project folder" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="External editor" />
           <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="EditorPathBox" Style="{StaticResource Tb}" TextChanged="Preference_Changed" AutomationProperties.Name="External editor executable path" />
            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Browse…" Margin="8,0,0,0" Click="BrowseEditor_Click" />
            <Button Grid.Column="2" Style="{StaticResource Btn}" Content="Open project" Margin="8,0,0,0" Click="OpenProjectEditor_Click" />
           </Grid>
           <TextBlock Style="{StaticResource Desc}" Text="Choose an editor executable. The app opens the current project folder and reports a non-blocking error if the editor is unavailable." />
          </StackPanel></Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>

       <TabItem Header="Regex builder" AutomationProperties.Name="Regex builder tab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <StackPanel x:Name="RegexBuilderPanel" Margin="26" MaxWidth="780">
          <TextBlock Style="{StaticResource H}" FontSize="22" Text=".NET regex builder" />
          <TextBlock Style="{StaticResource Desc}" Margin="2,3,0,16" Text="Build and test .NET regular expressions locally. Patterns are limited to 2,048 characters, samples to 100,000 characters, and evaluation to 150 ms." />
          <Border Style="{StaticResource Card}"><StackPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource Lbl}" Text="Raw pattern"/><TextBox x:Name="RegexPatternBox" Style="{StaticResource Tb}" TextChanged="RegexInput_Changed" AutomationProperties.Name="Raw regex pattern"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Style="{StaticResource Lbl}" Text="Flags"/><TextBox x:Name="RegexFlagsBox" Style="{StaticResource Tb}" Text="im" TextChanged="RegexInput_Changed" AutomationProperties.Name="Regex flags i m s n"/></StackPanel>
           </Grid>
           <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
             <Button Style="{StaticResource Btn}" Content="Escape literal" Click="RegexLiteral_Click"/><Button Style="{StaticResource Btn}" Content="[class]" Margin="8,0,0,0" Click="RegexClass_Click"/><Button Style="{StaticResource Btn}" Content="(group)" Margin="8,0,0,0" Click="RegexGroup_Click"/><Button Style="{StaticResource Btn}" Content="| alternate" Margin="8,0,0,0" Click="RegexAlternate_Click"/><Button Style="{StaticResource Btn}" Content="^ anchor $" Margin="8,0,0,0" Click="RegexAnchor_Click"/><Button Style="{StaticResource Btn}" Content="{}{1,}" Margin="8,0,0,0" Click="RegexQuantifier_Click"/>
           </StackPanel>
           <TextBlock Style="{StaticResource Lbl}" Text="Sample text" Margin="2,14,0,4"/><TextBox x:Name="RegexSampleBox" Style="{StaticResource Tb}" Height="180" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="RegexInput_Changed" AutomationProperties.Name="Regex sample text"/>
           <TextBlock x:Name="RegexFeedbackText" Style="{StaticResource Desc}" Margin="2,10,0,0" AutomationProperties.LiveSetting="Polite"/>
           <TextBox x:Name="RegexResultsBox" Style="{StaticResource Tb}" Height="180" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Regex matches and capture groups"/>
           <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Style="{StaticResource AccentBtn}" Content="Copy pattern" Click="CopyRegex_Click"/><Button Style="{StaticResource Btn}" Content="Export pattern…" Margin="8,0,0,0" Click="ExportRegex_Click"/></StackPanel>
          </StackPanel></Border>
         </StackPanel>
       </ScrollViewer>
       </TabItem>

       <TabItem Header="Changelog" AutomationProperties.Name="Application changelog tab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel x:Name="ChangelogPanel" Margin="26" MaxWidth="780">
          <TextBlock Style="{StaticResource H}" FontSize="{DynamicResource TitleFontSize}" Text="Changelog" />
          <TextBlock Style="{StaticResource Desc}" Margin="2,3,0,16"
                     Text="Browse every factual GitHub release recorded for this app. Date and text filters work together; no release data is fetched while the app runs." />

          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Date filter" />
           <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Style="{StaticResource Lbl}" Text="From (locale or YYYY-MM-DD)"/><TextBox x:Name="ChangelogStartBox" Style="{StaticResource Tb}" TextChanged="ChangelogFilter_Changed" AutomationProperties.Name="Changelog start date"/></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Style="{StaticResource Lbl}" Text="Through (locale or YYYY-MM-DD)"/><TextBox x:Name="ChangelogEndBox" Style="{StaticResource Tb}" TextChanged="ChangelogFilter_Changed" AutomationProperties.Name="Changelog end date"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Lbl}" Text="Preset"/><ComboBox x:Name="ChangelogPresetBox" MinWidth="150" SelectionChanged="ChangelogPreset_Changed" AutomationProperties.Name="Changelog date preset"><ComboBoxItem Content="All releases" IsSelected="True" Tag="all"/><ComboBoxItem Content="Last 30 days" Tag="30"/><ComboBoxItem Content="Last 90 days" Tag="90"/><ComboBoxItem Content="Last year" Tag="365"/></ComboBox></StackPanel>
           </Grid>
           <Expander Header="Advanced calendar" Margin="0,10,0,0" Foreground="{StaticResource Text}">
            <Calendar x:Name="ChangelogCalendar" SelectionMode="SingleRange" SelectedDatesChanged="ChangelogCalendar_Changed" AutomationProperties.Name="Changelog date range calendar" />
           </Expander>
           <TextBlock x:Name="ChangelogDateFeedback" Style="{StaticResource Desc}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Search release text" />
           <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="ChangelogSearchBox" Style="{StaticResource Tb}" TextChanged="ChangelogFilter_Changed" AutomationProperties.Name="Search changelog text" ToolTip="Plain-text search is the default."/>
            <CheckBox x:Name="ChangelogRegexModeCheck" Grid.Column="1" Content="Regex" Foreground="{StaticResource Text}" MinHeight="44" Margin="8,0,0,0" Click="ChangelogFilter_Changed" AutomationProperties.Name="Use regex changelog search"/>
            <Button Grid.Column="2" Style="{StaticResource Btn}" Content=".*" Margin="8,0,0,0" Click="ChangelogRegex_Click" AutomationProperties.Name="Open anchored changelog regex builder"/>
            <Popup x:Name="ChangelogRegexPopup" PlacementTarget="{Binding ElementName=ChangelogSearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Closed="ChangelogRegexPopup_Closed">
             <Border Style="{StaticResource Card}" MaxWidth="680" MinWidth="520" Margin="0,8,0,0"><StackPanel>
              <TextBlock Style="{StaticResource H}" Text="Changelog regex builder (.NET)"/>
              <TextBlock Style="{StaticResource Desc}" Text="Local-only .NET evaluation with a 2,048-character pattern, 100,000-character sample and 150 ms matching timeout."/>
              <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
               <TextBox x:Name="ChangelogRegexPattern" Style="{StaticResource Tb}" TextChanged="ChangelogRegexInput_Changed" AutomationProperties.Name="Changelog regex pattern"/>
               <TextBox x:Name="ChangelogRegexFlags" Grid.Column="1" Style="{StaticResource Tb}" Text="i" Margin="8,0,0,0" TextChanged="ChangelogRegexInput_Changed" AutomationProperties.Name="Changelog regex flags"/>
              </Grid>
              <WrapPanel Margin="0,10,0,0">
               <Button Style="{StaticResource Btn}" Content="Literal" Click="ChangelogRegexLiteral_Click"/><Button Style="{StaticResource Btn}" Content="[class]" Margin="8,0,0,0" Click="ChangelogRegexClass_Click"/><Button Style="{StaticResource Btn}" Content="(group)" Margin="8,0,0,0" Click="ChangelogRegexGroup_Click"/><Button Style="{StaticResource Btn}" Content="| alternate" Margin="8,0,0,0" Click="ChangelogRegexAlternate_Click"/><Button Style="{StaticResource Btn}" Content="^ anchor $" Margin="8,0,0,0" Click="ChangelogRegexAnchor_Click"/><Button Style="{StaticResource Btn}" Content="One or more" Margin="8,0,0,0" Click="ChangelogRegexQuantifier_Click"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Lbl}" Text="Sample text" Margin="2,12,0,4"/><TextBox x:Name="ChangelogRegexSample" Style="{StaticResource Tb}" Height="90" AcceptsReturn="True" TextChanged="ChangelogRegexInput_Changed" AutomationProperties.Name="Changelog regex sample text"/>
              <TextBlock x:Name="ChangelogRegexFeedback" Style="{StaticResource Desc}" AutomationProperties.LiveSetting="Polite"/><TextBox x:Name="ChangelogRegexResults" Style="{StaticResource Tb}" Height="90" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Changelog regex matches and capture groups"/>
              <WrapPanel Margin="0,10,0,0"><Button Style="{StaticResource Btn}" Content="Copy pattern" Click="ChangelogRegexCopy_Click"/><Button Style="{StaticResource Btn}" Content="Export pattern…" Margin="8,0,0,0" Click="ChangelogRegexExport_Click"/><Button Style="{StaticResource AccentBtn}" Content="Apply to changelog" Margin="8,0,0,0" Click="ChangelogRegexApply_Click"/></WrapPanel>
             </StackPanel></Border>
            </Popup>
           </Grid>
           <TextBlock x:Name="ChangelogSearchFeedback" Style="{StaticResource Desc}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel></Border>

          <Border Style="{StaticResource Card}"><StackPanel>
           <ListBox x:Name="ChangelogReleaseList" MinHeight="180" MaxHeight="260" SelectionChanged="ChangelogSelection_Changed" DisplayMemberPath="DisplayName" AutomationProperties.Name="Filtered releases"/>
           <TextBox x:Name="ChangelogDetailBox" Style="{StaticResource Tb}" MinHeight="180" MaxHeight="320" Margin="0,10,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected release details"/>
           <WrapPanel Margin="0,12,0,0"><Button x:Name="ChangelogCopySelectedBtn" Style="{StaticResource Btn}" Content="Copy selected" Click="ChangelogCopySelected_Click"/><Button x:Name="ChangelogCopyFilteredBtn" Style="{StaticResource Btn}" Content="Copy filtered view" Margin="8,0,0,0" Click="ChangelogCopyFiltered_Click"/><Button x:Name="ChangelogExportBtn" Style="{StaticResource AccentBtn}" Content="Export filtered Markdown…" Margin="8,0,0,0" Click="ChangelogExport_Click"/></WrapPanel>
          </StackPanel></Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>

       <TabItem Header="History" AutomationProperties.Name="Local version history tab">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel x:Name="HistoryPanel" Margin="26" MaxWidth="780">
          <TextBlock Style="{StaticResource H}" FontSize="{DynamicResource TitleFontSize}" Text="Local version history" />
          <TextBlock Style="{StaticResource Desc}" Margin="2,3,0,16"
                     Text="Every real settings or profile change is saved as a complete encrypted snapshot in an isolated local Git repository. Nothing is pushed unless you export it yourself." />
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Revisions" />
           <ListBox x:Name="HistoryRevisionList" MinHeight="180" MaxHeight="260"
                    SelectionChanged="HistorySelection_Changed" DisplayMemberPath="DisplayName"
                    AutomationProperties.Name="Saved application revisions" />
           <TextBlock x:Name="HistoryEmptyText" Style="{StaticResource Desc}" Text="No saved revisions yet." />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Changes from the selected revision" />
           <TextBox x:Name="HistoryDiffBox" Style="{StaticResource Tb}" MinHeight="180" MaxHeight="320"
                    IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Redacted settings difference" />
           <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="HistoryLabelBox" Style="{StaticResource Tb}" AutomationProperties.Name="Revision label" ToolTip="A short local label for the selected revision." />
            <Button Grid.Column="1" Style="{StaticResource Btn}" Content="Save label" Margin="8,0,0,0" Click="HistoryLabel_Click" />
           </Grid>
           <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource AccentBtn}" Content="Restore as new revision" Click="HistoryRestore_Click" AutomationProperties.Name="Restore selected settings as a new revision" />
            <Button Style="{StaticResource Btn}" Content="Export snapshot…" Margin="8,0,0,0" Click="HistoryExportSnapshot_Click" />
            <Button Style="{StaticResource Btn}" Content="Export repository…" Margin="8,0,0,0" Click="HistoryExportRepository_Click" />
           </WrapPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel>
           <TextBlock Style="{StaticResource H}" Text="Retention" />
           <TextBlock Style="{StaticResource Desc}" Text="Pruning rewrites this isolated local history. A decision prompt appears before anything is removed." />
           <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Lbl}" Text="Keep newest revisions" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="HistoryPruneKeepBox" Style="{StaticResource Tb}" Width="90" Text="100" AutomationProperties.Name="Number of newest revisions to keep" />
            <Button Style="{StaticResource DangerBtn}" Content="Prune history…" Margin="8,0,0,0" Click="HistoryPrune_Click" />
           </WrapPanel>
          </StackPanel></Border>
         </StackPanel>
        </ScrollViewer>
       </TabItem>

       <TabItem Header="Notifications" AutomationProperties.Name="Notification history tab">
        <StackPanel x:Name="NotificationsPanel" Margin="26">
         <TextBlock Style="{StaticResource H}" FontSize="22" Text="Notification history" />
         <TextBlock Style="{StaticResource Desc}" Margin="2,3,0,16" Text="Informational, success, progress and non-decision errors remain reviewable here after their corner notification closes." />
         <ListBox x:Name="NotificationHistoryList" MinHeight="300" DisplayMemberPath="DisplayText" AutomationProperties.Name="Notification history" />
         <Button Style="{StaticResource Btn}" Content="Clear history" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearNotifications_Click" />
        </StackPanel>
       </TabItem>
      </TabControl>

      <Border x:Name="ToastBorder" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="420" Margin="0,0,32,32" Padding="16" CornerRadius="20" Background="{StaticResource Surface2}"
              BorderBrush="{StaticResource Outline}" BorderThickness="1" Panel.ZIndex="20"
              AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Application notification">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="ToastTitle" Style="{StaticResource H}"/><TextBlock x:Name="ToastBody" Style="{StaticResource Desc}" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Style="{StaticResource Btn}" Content="×" Margin="12,0,0,0" Click="DismissToast_Click" AutomationProperties.Name="Dismiss notification"/>
       </Grid>
      </Border>

      <Border x:Name="DimSumToast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Width="420" Margin="0,0,32,32" Padding="12" CornerRadius="20" Background="{StaticResource Surface2}"
              BorderBrush="{StaticResource Outline}" BorderThickness="1" Panel.ZIndex="21" IsHitTestVisible="False">
       <StackPanel Orientation="Horizontal">
        <Image x:Name="DimSumImage" Width="144" Height="96" Stretch="UniformToFill" AutomationProperties.Name="Dim sum dish" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="DimSumName" Style="{StaticResource H}" FontSize="16"/><TextBlock x:Name="DimSumCopy" Style="{StaticResource Desc}" Width="220" Margin="0,5,0,0"/></StackPanel>
       </StackPanel>
      </Border>
    </Grid>
</Window>
